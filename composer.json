{
    "name": "migears/http-exceptions",
    "description": "A minimal collection of HTTP exception classes for PHP 8.1+",
    "type": "library",
    "license": "MIT",
    "version": "2.0.0",
    "keywords": [
        "http",
        "exceptions",
        "psr-4",
        "migears"
    ],
    "require": {
        "php": "^8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0"
    },
    "autoload": {
        "psr-4": {
            "MiGears\\HttpExceptions\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "MiGears\\HttpExceptions\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "scripts": {
        "test": "phpunit"
    }
}
